/*
 * ============================================================================
 *  ESM-2 DMS 大规模筛选 Nextflow 工作流 - 配置文件
 * ============================================================================
 *  使用方式:
 *    nextflow run main.nf --input samples_metadata.csv --output_dir nextflow_esm2/out -profile docker
 * ============================================================================
 */

params {
    // ---------- 数据参数 ----------
    seq_column             = "mutated_sequence"
    max_length             = 405
    test_size              = 0.2
    random_state           = 42

    // ---------- 输出参数 ----------
    save_best_only         = true

    // ---------- 模型参数 ----------
    model_name             = "/mnt/vol1/lucc/work/script/NF/esm2/hub/models--facebook--esm2_t36_3B_UR50D"
    cache_dir              = "/mnt/vol1/lucc/work/script/NF/esm2"
    num_labels             = 1
    freeze_layers          = 0

    // ---------- LoRA 参数 ----------
    use_lora               = true
    lora_r                 = 8
    lora_alpha             = 16
    lora_dropout           = 0.1
    target_modules         = "query,key,value,dense"   

    // ---------- 训练与早停参数 ----------
    batch_size             = 8
    gradient_accumulation_steps = 2
    epochs                 = 20
    learning_rate          = 5e-5
    lr_search_range        = "5e-6 1e-4"
    weight_decay           = 0.01
    optimizer              = "AdamW"
    scheduler              = "CosineAnnealingLR"          
    eta_min                = 1e-5
    max_grad_norm          = 1.0
    use_amp                = true
    patience               = 3        // 验证集指标连续多少次不提升则触发早停
    min_delta              = 0.0001   // 视为有效提升的最小变化量阈值

    // ---------- HPO (Optuna 自动超参搜索) 参数 ----------
    n_trials               = 5        // HPO 搜索试验次数
    epochs_hpo             = 5
    skip_hpo               = false

    // ---------- WandB 参数 ----------
    wandb_project          = "esm2-dms-HPO-esm2_t36_3B_UR50D"
    wandb_run_prefix       = "esm2"

    // ---------- 资源参数 ----------
    gpus                   = 1
    cpus                   = 104
    memory                 = "48.GB"
    maxForks               = 2
}

// ---------------------------------------------------------------------------
// 进程默认配置
// ---------------------------------------------------------------------------
process {
    cpus   = params.cpus
    memory = params.memory

    // 默认容器（所有进程共享）
    container = "my-gpu-app:v1.2"

    // 错误重试
//  errorStrategy = 'retry'
//  maxRetries    = 2
}

// ---------------------------------------------------------------------------
// Docker 运行配置
// 使用: nextflow run main.nf -profile docker
// ---------------------------------------------------------------------------
profiles {
    docker {
        docker.enabled         = true
        docker.userOwnership   = true
        docker.runOptions      = '--user root -v /mnt/:/mnt/ --gpus all --privileged -u $(id -u):$(id -g)' 
        docker.cliPath         = '/usr/bin/sudo /usr/bin/docker'
        apptainer.enabled      = false
    }
}

// ---------------------------------------------------------------------------
// 执行器配置
// ---------------------------------------------------------------------------
executor {
    name = 'local'
    queueSize = 2   // 最大并行任务数（GPU 数量决定）
}

// ---------------------------------------------------------------------------
// 工作目录 & 报告
// ---------------------------------------------------------------------------
workDir = "/mnt/vol1/lucc/work/nf_work/esm2"

// 运行报告
report {
    enabled = true
    file    = "${params.output_dir}/reports/execution_report.html"
}

// 时间线
timeline {
    enabled = true
    file    = "${params.output_dir}/reports/timeline.html"
}

// DAG 流程图
dag {
    enabled = true
    file    = "${params.output_dir}/reports/dag.html"
}

env {
    // 宿主机上的缓存目录，映射到运行环境
    HF_HOME = "/mnt/vol1/lucc/work/script/NF/esm2"
    TRANSFORMERS_OFFLINE = "1" // 如果内网断网，可设为 "1" 仅使用本地缓存
    HF_HUB_OFFLINE       = "1"
    TRANSFORMERS_SUPPRESS_TORCH_LOAD_WARNING = '1'
}